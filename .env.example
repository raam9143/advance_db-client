# Copy to .env and replace ALL placeholders before use. Never commit .env.
APP_PASSWORD=replace-with-a-strong-unique-password
APP_SESSION_SECRET=replace-with-at-least-32-random-bytes
API_TOKEN=replace-with-a-different-random-api-token

# Optional SQLite snapshots. The directory must exist and be owner-private (chmod 700).
# SQLITE_BACKUP_DIR=/var/lib/advance-db-client/backups

# Disabled by default. Provider receives redacted SQL text ONLY after interactive consent.
# AI_ASSIST_ENABLED=false
# OPENAI_API_KEY=from-a-secure-secret-store
# AI_MODEL=gpt-4o-mini
# Optional browser TOTP factor:
# APP_REQUIRE_TOTP=false
# APP_TOTP_SECRET=BASE32_SECRET_PROVISIONED_OUT_OF_BAND
# Persistent local integrity-checked audit (single-process only):
# AUDIT_LOG_PATH=/var/lib/advance-db-client/audit/activity.jsonl
# AUDIT_HMAC_KEY=minimum_32_random_bytes_from_secret_store
# SSH port-forwarding requires the pinned bastion and database allowlists:
# SSH_TUNNEL_ENABLED=false
# SSH_KNOWN_HOSTS_FILE=/etc/advance-db/ssh_known_hosts
# SSH_BASTION_ALLOWLIST=bastion.internal:22
# SSH_DB_TARGET_ALLOWLIST=127.0.0.1:5432,127.0.0.1:3306
