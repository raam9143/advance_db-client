# Copy to .env and replace ALL placeholders before use. Never commit .env.
APP_PASSWORD=replace-with-a-strong-unique-password
APP_SESSION_SECRET=replace-with-at-least-32-random-bytes
API_TOKEN=replace-with-a-different-random-api-token

# Optional SQLite snapshots. The directory must exist and be owner-private (chmod 700).
# SQLITE_BACKUP_DIR=/var/lib/advance-db-client/backups
